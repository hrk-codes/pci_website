{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PCI: Start website and API",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:\\Program Files\\nodejs;${env:PATH}"
        }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "PCI: Check code",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["run", "lint"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:\\Program Files\\nodejs;${env:PATH}"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "PCI: Build check",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["run", "build"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:\\Program Files\\nodejs;${env:PATH}"
        }
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
